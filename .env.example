# Copy to .env and fill in real values. Never commit .env.

# --- Load target -------------------------------------------------------------
# supabase = batch upsert over the Supabase REST API (default, used in prod/Docker)
# postgres = bulk insert into a local/SQLAlchemy Postgres database
ETL_BACKEND=supabase

# Supabase (required when ETL_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Optional, one-time setup only: personal access token used by
# python -m db_schema.create_supabase_schema (revoke after use).
# SUPABASE_ACCESS_TOKEN=sbp_xxx

# Local Postgres (required when ETL_BACKEND=postgres)
# Used by db_schema tooling and the SQLAlchemy loader.
DATABASE_URL=postgresql://user:password@localhost:5432/brazilretail_bi

# NOTE: the dashboard does NOT read this file. Vite only loads dashboard/.env —
# copy dashboard/.env.example to dashboard/.env for the frontend credentials.
