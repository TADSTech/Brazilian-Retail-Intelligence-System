# Copy to .env and fill in real values. Never commit .env.

# --- Load target -------------------------------------------------------------
# supabase = batch upsert over the Supabase REST API (default, used in prod/Docker)
# postgres = bulk insert into a local/SQLAlchemy Postgres database
ETL_BACKEND=supabase

# Supabase (required when ETL_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Local Postgres (required when ETL_BACKEND=postgres)
# Used by db_schema tooling and the SQLAlchemy loader.
DATABASE_URL=postgresql://user:password@localhost:5432/brazilretail_bi

# Optional: dashboard local dev (Vite reads VITE_ prefixed vars)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
